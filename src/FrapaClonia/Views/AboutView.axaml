<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrapaClonia.UI.ViewModels;assembly=FrapaClonia.UI"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
        x:Class="FrapaClonia.Views.AboutView"
        x:DataType="vm:AboutViewModel"
        Title="{Binding Title}"
        Width="480"
        Height="435"
        MinWidth="480"
        MinHeight="435"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="False"
        Background="{DynamicResource SystemPageBackgroundBrush}">

  <Window.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />

    <!-- Link button style - no color change on hover, underline on hover -->
    <Style Selector="Button.link-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.link-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link-button:pointerover TextBlock.underline-on-hover">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <!-- Header with App Icon and Name -->
    <StackPanel Grid.Row="0" Spacing="16" Orientation="Horizontal" HorizontalAlignment="Center">
      <Image Source="/Assets/favicon.ico"
             Width="64"
             Height="64"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="FrapaClonia"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                   FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Content -->
    <StackPanel Grid.Row="1" Spacing="16" Margin="0,24,0,0">
      <!-- Description -->
      <Border Classes="card" Padding="16">
        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      </Border>

      <!-- Info Cards -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <!-- License -->
        <Border Grid.Column="0" Classes="card" Padding="12">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <mi:MaterialIcon Kind="Certificate"
                               Width="18" Height="18"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Text="{local:Localize License}"
                         FontWeight="SemiBold"
                         FontSize="13" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Apache License 2.0"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Padding="10,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <!-- Links -->
        <Border Grid.Column="1" Classes="card" Padding="12">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <mi:MaterialIcon Kind="Github"
                               Width="18" Height="18"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Text="GitHub"
                         FontWeight="SemiBold"
                         FontSize="13" />
            </StackPanel>
            <Button Grid.Row="1"
                    Command="{Binding OpenProjectUrlCommand}"
                    Classes="link-button"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
              <TextBlock Text="{Binding ProjectUrlShort}"
                         FontSize="13"
                         Foreground="{DynamicResource SystemAccentColor}"
                         Classes="underline-on-hover" />
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- Copyright -->
      <TextBlock Text="{Binding Copyright}"
                 FontSize="11"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>

    <!-- Footer -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="12"
                Margin="0,16,0,0">
      <Button Command="{Binding CloseCommand}"
              Classes="primary"
              MinWidth="80"
              Content="{local:Localize Close}" />
    </StackPanel>
  </Grid>
</Window>
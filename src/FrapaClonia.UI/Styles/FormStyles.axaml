<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ap="clr-namespace:FrapaClonia.UI.AttachedProperties;assembly=FrapaClonia.UI">

  <!-- =============================================
       FORM STYLES
       ============================================= -->

  <!-- Form Field -->
  <Style Selector="Border.form-field">
    <Setter Property="Background" Value="{DynamicResource SystemControlPageBackgroundAltLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
    <Setter Property="Padding" Value="{StaticResource ThicknessS}" />
    <Setter Property="Margin" Value="{StaticResource ThicknessBottomS}" />
  </Style>

  <Style Selector="Border.form-field.error-border">
    <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}" />
  </Style>

  <!-- Form Label -->
  <Style Selector="TextBlock.form-label">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.form-label.required">
    <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
  </Style>

  <!-- Form Hint -->
  <Style Selector="TextBlock.form-hint">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Form Field StackPanel -->
  <Style Selector="StackPanel.form-field">
    <Setter Property="Spacing" Value="4" />
  </Style>

  <!-- =============================================
       HINT TOOLTIP ICON STYLES
       ============================================= -->

  <!-- Hint icon button - includes Information icon by default -->
  <Style Selector="Button.hint-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ap:ClickTooltip.IsEnabled" Value="True" />
    <Setter Property="Content">
      <Template>
        <mi:MaterialIcon Kind="Information"
                         Width="14" Height="14"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="Button.hint-icon:pointerover">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.hint-icon /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Label with hint icon container -->
  <Style Selector="StackPanel.label-with-hint">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="4" />
  </Style>

</Styles>

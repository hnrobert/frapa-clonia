<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <!-- =============================================
       BUTTON STYLES - Unified System

       Button Classes can be combined:
       - Variant: primary, ghost
       - Layout: icon-text-button (icon + text), icon-button (icon only)
       - Special: action-button (for toolbars/actions)

       Examples:
       - Classes="primary icon-text-button" → Primary button with icon + text
       - Classes="action-button icon-text-button" → Toolbar action button
       - Classes="icon-button" → Icon-only button

       Icon-Text Button Layout:
       - Equal left/right padding (12px)
       - Icon-to-text spacing: 6px
       - Content: <StackPanel Orientation="Horizontal"><mi:MaterialIcon/><TextBlock/></StackPanel>
       ============================================= -->

  <!-- Base Button Style -->
  <Style Selector="Button">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{StaticResource ButtonHeightL}" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusM}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Icon-Text Button Layout Style -->
  <Style Selector="Button.icon-text-button">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{StaticResource ButtonHeightL}" />
  </Style>

  <Style Selector="Button.icon-text-button > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>

  <Style Selector="Button.icon-text-button > StackPanel > mi|MaterialIcon">
    <Setter Property="Width" Value="{StaticResource IconSizeM}" />
    <Setter Property="Height" Value="{StaticResource IconSizeM}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon-text-button > StackPanel > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Primary Variant -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumBrush}" />
  </Style>

  <!-- Ghost Variant (transparent, subtle hover) -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
  </Style>

  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
  </Style>

  <!-- Icon-Only Button (square, centered icon) -->
  <Style Selector="Button.icon-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Button.icon-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon-button:pressed">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
  </Style>

  <Style Selector="Button.icon-button:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Icon Menu (looks like icon-button but is a dropdown menu) -->
  <Style Selector="Menu.icon-menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- MenuItem inside icon-menu gets the icon-button styling -->
  <Style Selector="Menu.icon-menu > MenuItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Menu.icon-menu:pointerover">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Menu.icon-menu > MenuItem /template/ Border#MainContainer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
  </Style>

  <Style Selector="Menu.icon-menu > MenuItem:pointerover /template/ Border#MainContainer">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
  </Style>

  <Style Selector="Menu.icon-menu > MenuItem:pressed /template/ Border#MainContainer">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
  </Style>

  <!-- Action Button (for toolbars, with consistent sizing) -->
  <Style Selector="Button.action-button">
    <Setter Property="Height" Value="{StaticResource ButtonHeightL}" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusM}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>

  <Style Selector="Button.action-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
  </Style>

  <!-- Action Button + Primary Variant -->
  <Style Selector="Button.action-button.primary">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
  </Style>

  <Style Selector="Button.action-button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}" />
  </Style>

</Styles>

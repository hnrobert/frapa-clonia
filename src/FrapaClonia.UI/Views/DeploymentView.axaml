<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrapaClonia.UI.ViewModels;assembly=FrapaClonia.UI"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:FrapaClonia.UI.Converters;assembly=FrapaClonia.UI"
             xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700"
             x:Class="FrapaClonia.UI.Views.DeploymentView"
             x:DataType="vm:DeploymentViewModel">

  <Design.DataContext>
    <vm:DeploymentViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <converters:BoolToAvailableStringConverter x:Key="BoolToAvailableStringConverter" />
    <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Page Header -->
    <Border Grid.Row="0" Classes="page-header">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="{StaticResource SpacingS}">
          <TextBlock Text="{local:Localize Deployment}"
                     Classes="page-title" />
          <TextBlock Text="{local:Localize DeploymentDescription}"
                     Classes="page-subtitle" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Page Content -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Border Classes="page-content">
        <StackPanel Spacing="{StaticResource SpacingL}">
          <!-- Deployment Mode Selection -->
          <Border Classes="settings-card">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{local:Localize DeploymentMode}"
                           Classes="section-title"
                           VerticalAlignment="Center" />

              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <RadioButton Content="Native"
                             IsChecked="{Binding SelectedDeploymentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=native, Mode=TwoWay}"
                             GroupName="DeploymentMode" />
                <RadioButton Content="Docker"
                             IsChecked="{Binding SelectedDeploymentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=docker, Mode=TwoWay}"
                             GroupName="DeploymentMode" />
                <Button Classes="hint-icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{local:Localize ChooseHowYouWantToDeployAndRunFrpc}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Native Deployment Panel -->
          <Border Classes="settings-card" IsVisible="{Binding IsNativeMode}">
            <StackPanel Spacing="{StaticResource SpacingL}">
              <TextBlock Text="{local:Localize ServiceConfiguration}"
                         Classes="section-title" />

              <!-- Frpc Executable Configuration -->
              <StackPanel Spacing="{StaticResource SpacingM}">
                <TextBlock Text="{local:Localize FrpcExecutableLocation}"
                           Classes="field-label" />

                <!-- Path Input with Check and Configure Buttons -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding FrpcBinaryPath}"
                           Watermark="{local:Localize SelectFrpcBinary}"
                           IsReadOnly="True"
                           Margin="0,0,8,0" />
                  <Button Grid.Column="1"
                          Command="{Binding CheckFrpcPathCommand}"
                          IsEnabled="{Binding !IsCheckingPath}"
                          Classes="action-button"
                          Margin="0,0,8,0"
                          ToolTip.Tip="{local:Localize CheckFrpcPathToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <mi:MaterialIcon Kind="Check" />
                      <TextBlock Text="{local:Localize Check}" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2"
                          Command="{Binding ConfigureFrpcCommand}"
                          Classes="action-button primary"
                          ToolTip.Tip="{local:Localize ConfigureFrpcToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <mi:MaterialIcon Kind="Cog" />
                      <TextBlock Text="{local:Localize Configure}" />
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Validation Status -->
                <Grid ColumnDefinitions="*,Auto">
                  <!-- Checking indicator -->
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal" Spacing="8"
                              IsVisible="{Binding IsCheckingPath}">
                    <mi:MaterialIcon Kind="Loading" Width="20" Height="20" />
                    <TextBlock Text="{local:Localize CheckingFrpc}"
                               VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Valid path status -->
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal" Spacing="8"
                              IsVisible="{Binding !IsCheckingPath}">
                    <mi:MaterialIcon Kind="CheckCircle"
                                     Foreground="Green"
                                     IsVisible="{Binding IsPathValid}"
                                     Width="20" Height="20" />
                    <mi:MaterialIcon Kind="AlertCircle"
                                     Foreground="Orange"
                                     IsVisible="{Binding !IsPathValid}"
                                     Width="20" Height="20" />
                    <TextBlock Text="{Binding DetectedVersion, StringFormat='v{0}'}"
                               IsVisible="{Binding IsPathValid}"
                               Foreground="Green"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{local:Localize FrpcNotConfigured}"
                               IsVisible="{Binding !IsPathValid}"
                               Foreground="Orange"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- Service Configuration Section -->
              <Border Classes="settings-card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="{StaticResource SpacingM}">
                  <TextBlock Text="{local:Localize SystemServiceSettings}"
                             Classes="section-title" />

                  <StackPanel Spacing="8">
                    <TextBlock Text="{local:Localize ServiceScope}"
                               Classes="field-label" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <RadioButton Content="{local:Localize UserLevel}"
                                   IsChecked="{Binding ServiceScopeValue, Converter={StaticResource StringEqualsConverter}, ConverterParameter=user}"
                                   GroupName="ServiceScope" />
                      <RadioButton Content="{local:Localize SystemLevel}"
                                   IsChecked="{Binding ServiceScopeValue, Converter={StaticResource StringEqualsConverter}, ConverterParameter=system}"
                                   GroupName="ServiceScope" />
                    </StackPanel>

                    <CheckBox Content="{local:Localize StartOnBoot}"
                              IsChecked="{Binding AutoStartOnBoot}" />

                    <!-- Service Status -->
                    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto"
                          Margin="0,8,0,0">
                      <TextBlock Grid.Row="0" Grid.Column="0"
                                 Text="{local:Localize ServiceStatus}"
                                 Classes="field-label" />
                      <StackPanel Grid.Row="0" Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="{StaticResource SpacingM}">
                        <TextBlock Text="{Binding LocalizedServiceState, FallbackValue=Unknown}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource MonoFontFamily}" />
                        <Button Command="{Binding RefreshServiceStatusCommand}"
                                IsEnabled="{Binding !IsServiceChecking}"
                                Classes="action-button">
                          <mi:MaterialIcon Kind="Refresh" />
                        </Button>
                      </StackPanel>
                    </Grid>

                    <!-- Service Control Buttons -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource SpacingM}"
                                Margin="0,8,0,0">
                      <Button Command="{Binding InstallServiceCommand}"
                              IsVisible="{Binding !IsServiceInstalled}"
                              IsEnabled="{Binding IsPathValid}"
                              Classes="action-button primary icon-text-button">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <mi:MaterialIcon Kind="Cog" />
                          <TextBlock Text="{local:Localize InstallService}" />
                        </StackPanel>
                      </Button>
                      <Button Command="{Binding UninstallServiceCommand}"
                              IsVisible="{Binding IsServiceInstalled}"
                              Classes="action-button icon-text-button">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <mi:MaterialIcon Kind="Delete" />
                          <TextBlock Text="{local:Localize UninstallService}" />
                        </StackPanel>
                      </Button>
                      <Button Command="{Binding StartServiceCommand}"
                              IsVisible="{Binding IsServiceInstalled}"
                              IsEnabled="{Binding !IsServiceRunning}"
                              Classes="action-button icon-text-button">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <mi:MaterialIcon Kind="Play" />
                          <TextBlock Text="{local:Localize Start}" />
                        </StackPanel>
                      </Button>
                      <Button Command="{Binding StopServiceCommand}"
                              IsVisible="{Binding IsServiceInstalled}"
                              IsEnabled="{Binding IsServiceRunning}"
                              Classes="action-button icon-text-button">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <mi:MaterialIcon Kind="Stop" />
                          <TextBlock Text="{local:Localize Stop}" />
                        </StackPanel>
                      </Button>
                      <Button Command="{Binding ViewLogsCommand}"
                              IsVisible="{Binding IsServiceInstalled}"
                              Classes="action-button icon-text-button">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <mi:MaterialIcon Kind="TextBox" />
                          <TextBlock Text="{local:Localize ViewLogs}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Docker Deployment Panel -->
          <Border Classes="settings-card" IsVisible="{Binding IsDockerMode}">
            <StackPanel Spacing="{StaticResource SpacingL}">
              <TextBlock Text="{local:Localize DockerDeployment}"
                         Classes="section-title" />

              <!-- Docker status + compose path -->
              <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource SpacingS}">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{local:Localize DockerStatus}"
                           Classes="field-label" />
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpacingM}">
                  <TextBlock
                    Text="{Binding IsDockerAvailable, Converter={StaticResource BoolToAvailableStringConverter}}"
                    VerticalAlignment="Center" />
                  <Button Command="{Binding CheckDockerCommand}"
                          Content="{local:Localize CheckDocker}"
                          IsEnabled="{Binding !IsDockerChecking}"
                          Classes="action-button" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{local:Localize DockerComposePath}"
                           Classes="field-label" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding DockerComposePath}"
                         IsReadOnly="True"
                         Watermark="Not generated yet"
                         Margin="0,0,8,0" />
                <Button Grid.Row="1" Grid.Column="2"
                        Click="DockerComposeBrowseButton_OnClick"
                        Classes="action-button"
                        ToolTip.Tip="{local:Localize BrowseToolTip}">
                  <mi:MaterialIcon Kind="FolderOpen" />
                </Button>
              </Grid>

              <!-- Card 2: Compose file properties -->
              <Border Classes="settings-card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="{StaticResource SpacingM}">
                  <TextBlock Text="Compose Configuration"
                             Classes="section-title" />
                  <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="{StaticResource SpacingS}">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{local:Localize ContainerName}"
                               Classes="field-label" />
                    <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                      <TextBox Text="{Binding DockerContainerName}"
                               Watermark="frapa-clonia-frpc"
                               MinWidth="200"
                               Padding="8,4,32,4"
                               VerticalContentAlignment="Center"
                               LostFocus="DockerContainerNameTextBox_OnLostFocus" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Spacing="6"
                                  IsHitTestVisible="False">
                        <mi:MaterialIcon Kind="Loading"
                                         Width="18" Height="18"
                                         IsVisible="{Binding ShowDockerContainerNameChecking}" />
                        <mi:MaterialIcon Kind="CheckCircle"
                                         Foreground="Green"
                                         Width="18" Height="18"
                                         IsVisible="{Binding ShowDockerContainerNameOk}" />
                        <mi:MaterialIcon Kind="AlertCircle"
                                         Foreground="Orange"
                                         Width="18" Height="18"
                                         IsVisible="{Binding ShowDockerContainerNameConflict}" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{local:Localize DockerImage}"
                               Classes="field-label" />
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                      <TextBox Text="{Binding DockerImageName}"
                               Watermark="fatedier/frpc"
                               Padding="8,4,32,4"
                               VerticalContentAlignment="Center"
                               LostFocus="DockerImageNameTextBox_OnLostFocus" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Spacing="6"
                                  IsHitTestVisible="False">
                        <mi:MaterialIcon Kind="Loading"
                                         Width="18" Height="18"
                                         IsVisible="{Binding ShowDockerImageChecking}" />
                        <mi:MaterialIcon Kind="CheckCircle"
                                         Foreground="Green"
                                         Width="18" Height="18"
                                         IsVisible="{Binding ShowDockerImageOk}" />
                        <mi:MaterialIcon Kind="AlertCircle"
                                         Foreground="Orange"
                                         Width="18" Height="18"
                                         IsVisible="{Binding ShowDockerImageConflict}" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{local:Localize Version}"
                               Classes="field-label" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding DockerImageTags}"
                              SelectedIndex="{Binding DockerImageTagSelectedIndex, Mode=TwoWay}"
                              IsEnabled="{Binding !IsDockerImageTagsLoading}"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,8,0" />
                    <Button Grid.Row="2" Grid.Column="2"
                            Command="{Binding RefreshDockerImageTagsCommand}"
                            IsEnabled="{Binding !IsDockerImageTagsLoading}"
                            Classes="action-button"
                            ToolTip.Tip="{local:Localize CheckVersions}">
                      <mi:MaterialIcon Kind="Refresh" />
                    </Button>

                    <StackPanel Grid.Row="3" Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource SpacingXS}">
                      <TextBlock Text="{local:Localize RestartPolicy}"
                                 Classes="field-label" />
                      <Button Classes="hint-icon"
                              ToolTip.Tip="{Binding DockerRestartPolicyHelp}" />
                    </StackPanel>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding DockerRestartPolicies}"
                              SelectedItem="{Binding DockerRestartPolicy}"
                              HorizontalAlignment="Left"
                              Margin="0,0,8,0" />
                  </Grid>

                  <StackPanel Orientation="Horizontal"
                              Spacing="{StaticResource SpacingM}">
                    <Button Command="{Binding SaveDockerComposeCommand}"
                            Classes="action-button primary icon-text-button">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="ContentSave" />
                        <TextBlock Text="{local:Localize Save}" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding RestoreDockerComposeFromFileCommand}"
                            IsEnabled="{Binding CanRestoreDockerComposeFromFile}"
                            Classes="action-button icon-text-button">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Undo" />
                        <TextBlock Text="{local:Localize RestoreFromFile}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Card 3: Runtime status + controls -->
              <Border Classes="settings-card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="{StaticResource SpacingM}">
                  <TextBlock Text="{local:Localize DeploymentStatus}"
                             Classes="section-title" />
                  <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto"
                        RowSpacing="{StaticResource SpacingS}">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{local:Localize DockerStatus}"
                               Classes="field-label" />
                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpacingM}">
                      <Border Classes="status-indicator running" IsVisible="{Binding IsContainerRunning}" />
                      <Border Classes="status-indicator stopped" IsVisible="{Binding !IsContainerRunning}" />
                      <TextBlock Text="{Binding LocalizedContainerState}"
                                 VerticalAlignment="Center"
                                 FontFamily="{DynamicResource MonoFontFamily}" />
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="2"
                            Command="{Binding RefreshContainerStatusCommand}"
                            Classes="action-button">
                      <mi:MaterialIcon Kind="Refresh" />
                    </Button>
                  </Grid>

                  <StackPanel Orientation="Horizontal"
                              Spacing="{StaticResource SpacingM}">
                    <Button Command="{Binding StartDockerCommand}"
                            Classes="action-button primary icon-text-button">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Play" IsVisible="{Binding !IsContainerRunning}" />
                        <mi:MaterialIcon Kind="Restart" IsVisible="{Binding IsContainerRunning}" />
                        <TextBlock Text="{Binding DockerPrimaryActionText}" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding StopDockerCommand}"
                            IsEnabled="{Binding CanStopDockerContainer}"
                            Classes="action-button icon-text-button">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Stop" />
                        <TextBlock Text="{local:Localize StopContainer}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrapaClonia.UI.ViewModels;assembly=FrapaClonia.UI"
             xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="FrapaClonia.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Design.DataContext>
    <vm:SettingsViewModel />
  </Design.DataContext>

  <UserControl.Resources>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel Margin="{StaticResource ContentPadding}">
      <StackPanel Spacing="{StaticResource SpacingL}">
        <!-- Header -->
        <TextBlock Text="{local:Localize Settings}"
                   FontSize="{StaticResource FontSizeXXXL}"
                   FontWeight="{StaticResource FontWeightSemiBold}"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

        <!-- Language Settings -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize LanguageAndRegion}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{local:Localize InterfaceLanguage}"
                           Classes="field-label" />
                <Button Classes="hint-icon"
                        ToolTip.Tip="{local:Localize ChangesWillTakeEffectImmediately}" />
              </StackPanel>
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding SelectedLanguage}"
                        Classes="settings-dropdown"
                        AutomationProperties.Name="Interface Language">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Startup Settings -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize SystemIntegration}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />

            <StackPanel Orientation="Horizontal" Spacing="4">
              <CheckBox IsChecked="{Binding AutoStartEnabled}"
                        Classes="settings-checkbox"
                        AutomationProperties.Name="Start on system boot">
                <AccessText Text="{local:Localize StartOnSystemBoot}"
                            FontSize="{StaticResource FontSizeM}"
                            FontWeight="{StaticResource FontWeightMedium}"
                            VerticalAlignment="Center" />
              </CheckBox>
              <Button Classes="hint-icon"
                      Margin="0,4,0,0"
                      ToolTip.Tip="{local:Localize AutomaticallyLaunchFrapaClonia}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Appearance Settings -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize Appearance}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{local:Localize Theme}"
                           Classes="field-label" />
                <Button Classes="hint-icon"
                        ToolTip.Tip="{local:Localize ChooseYourPreferredColorTheme}" />
              </StackPanel>
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding AvailableThemes}"
                        SelectedIndex="{Binding ThemeIndex}"
                        Classes="settings-dropdown"
                        AutomationProperties.Name="Theme">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Updates -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize Updates}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />

            <!-- Current version -->
            <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}"
                       Classes="readonly-value" />

            <!-- Update available -->
            <StackPanel IsVisible="{Binding UpdateAvailable}" Spacing="4" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⬆" Foreground="#4CAF50" VerticalAlignment="Center" />
                  <TextBlock Text="{local:Localize UpdateAvailable}" Classes="field-label"
                             Foreground="#4CAF50" />
                </StackPanel>
                <TextBlock Text="{Binding LatestVersion, StringFormat='v{0}'}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding InstallUpdateCommand}"
                          IsEnabled="{Binding !IsDownloadingUpdate}"
                          Classes="action-button">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <mi:MaterialIcon Kind="Loading" Width="16" Height="16"
                                       IsVisible="{Binding IsDownloadingUpdate}" />
                      <TextBlock IsVisible="{Binding IsDownloadingUpdate}"
                                 Text="{Binding UpdateDownloadProgress, StringFormat='{}{0:F0}%'}" />
                      <mi:MaterialIcon Kind="Download" Width="16" Height="16"
                                       IsVisible="{Binding !IsDownloadingUpdate}" />
                      <TextBlock IsVisible="{Binding !IsDownloadingUpdate}"
                                 Text="{local:Localize InstallUpdate}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding OpenReleasePageCommand}"
                          Classes="action-button"
                          Content="{local:Localize ViewReleaseNotes}" />
                </StackPanel>
              </StackPanel>
              <ProgressBar Value="{Binding UpdateDownloadProgress}"
                           Maximum="100"
                           IsVisible="{Binding IsDownloadingUpdate}"
                           Margin="0,4,0,0"
                           Height="4" />
            </StackPanel>

            <!-- Prerelease available -->
            <StackPanel IsVisible="{Binding PrereleaseAvailable}" Spacing="4" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⬆" Foreground="#FF9800" VerticalAlignment="Center" />
                  <TextBlock Text="{local:Localize PrereleaseAvailable}" Classes="field-label"
                             Foreground="#FF9800" />
                  <TextBlock Text="{Binding LatestPrereleaseVersion, StringFormat='v{0}'}" Classes="field-label" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding InstallPrereleaseCommand}"
                          IsEnabled="{Binding !IsDownloadingPrerelease}"
                          Classes="action-button">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <mi:MaterialIcon Kind="Loading" Width="16" Height="16"
                                       IsVisible="{Binding IsDownloadingPrerelease}" />
                      <TextBlock IsVisible="{Binding IsDownloadingPrerelease}"
                                 Text="{Binding PrereleaseDownloadProgress, StringFormat='{}{0:F0}%'}" />
                      <mi:MaterialIcon Kind="Download" Width="16" Height="16"
                                       IsVisible="{Binding !IsDownloadingPrerelease}" />
                      <TextBlock IsVisible="{Binding !IsDownloadingPrerelease}"
                                 Text="{local:Localize InstallPrerelease}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding OpenPrereleasePageCommand}"
                          Classes="action-button"
                          Content="{local:Localize ViewReleaseNotes}" />
                </StackPanel>
              </StackPanel>
              <ProgressBar Value="{Binding PrereleaseDownloadProgress}"
                           Maximum="100"
                           IsVisible="{Binding IsDownloadingPrerelease}"
                           Margin="0,4,0,0"
                           Height="4" />
            </StackPanel>

            <!-- Check for updates button -->
            <Button Command="{Binding CheckForUpdatesCommand}"
                    Classes="action-button"
                    IsEnabled="{Binding !IsCheckingForUpdates}"
                    Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <mi:MaterialIcon Kind="Refresh" Width="18" Height="18"
                                 IsVisible="{Binding !IsCheckingForUpdates}" />
                <mi:MaterialIcon Kind="Loading" Width="18" Height="18"
                                 IsVisible="{Binding IsCheckingForUpdates}" />
                <TextBlock Text="{local:Localize CheckForUpdates}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- GitHub Integration -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize GitHubIntegration}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />

            <!-- Logged out state -->
            <StackPanel IsVisible="{Binding !IsGitHubLoggedIn}" Spacing="8">
              <TextBlock Text="{local:Localize GitHubConnectDescription}"
                         Classes="field-label"
                         TextWrapping="Wrap"
                         Opacity="0.7" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding GitHubLoginCommand}"
                        Classes="action-button"
                        Content="{local:Localize GenerateGitHubPAT}" />
              </StackPanel>
              <TextBlock Text="{local:Localize GitHubTokenPrompt}"
                         Classes="field-label"
                         TextWrapping="Wrap"
                         Opacity="0.5"
                         Margin="0,4,0,0" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding GitHubTokenInput}"
                         PasswordChar="•"
                         Watermark="{local:Localize GitHubTokenLabel}" />
                <Button Grid.Column="1"
                        Command="{Binding GitHubConnectCommand}"
                        Classes="action-button primary"
                        Content="{local:Localize Connect}"
                        IsEnabled="{Binding GitHubTokenInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </Grid>
            </StackPanel>

            <!-- Logged in state -->
            <StackPanel IsVisible="{Binding IsGitHubLoggedIn}" Spacing="8">
              <!-- Status indicator -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="✔" Foreground="#4CAF50" VerticalAlignment="Center"
                           IsVisible="{Binding IsGitHubConnected}" />
                <TextBlock Text="{local:Localize ConnectedToGitHub}" Classes="field-label"
                           Foreground="#4CAF50"
                           IsVisible="{Binding IsGitHubConnected}" />
                <TextBlock Text="⚠" Foreground="#FFA000" VerticalAlignment="Center"
                           IsVisible="{Binding IsGitHubTokenInvalid}" />
                <TextBlock Text="{local:Localize GitHubTokenInvalid}" Classes="field-label"
                           Foreground="#FFA000"
                           IsVisible="{Binding IsGitHubTokenInvalid}" />
              </StackPanel>

              <!-- Action buttons -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding GitHubLogoutCommand}"
                        Classes="action-button"
                        Content="{local:Localize Disconnect}" />
                <Button Command="{Binding GitHubUpdateCommand}"
                        Classes="action-button"
                        Content="{local:Localize UpdateToken}"
                        IsVisible="{Binding !IsGitHubUpdating}" />
                <Button Classes="action-button"
                        Command="{Binding GitHubVerifyCachedCommand}"
                        IsVisible="{Binding !IsGitHubUpdating}"
                        ToolTip.Tip="{local:Localize VerifyToken}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <mi:MaterialIcon Kind="ShieldCheck" />
                    <TextBlock Text="{local:Localize Verify}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Update token panel -->
              <StackPanel IsVisible="{Binding IsGitHubUpdating}" Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0"
                           Text="{Binding GitHubTokenInput}"
                           PasswordChar="{Binding TokenPasswordChar}"
                           Watermark="{local:Localize GitHubTokenLabel}" />
                  <Button Grid.Column="1" Classes="icon-button"
                          Command="{Binding GitHubToggleTokenVisibilityCommand}"
                          ToolTip.Tip="{local:Localize ToggleTokenVisibility}">
                    <Panel>
                      <mi:MaterialIcon Kind="Eye" IsVisible="{Binding !IsTokenVisible}" Width="18" Height="18" />
                      <mi:MaterialIcon Kind="EyeOff" IsVisible="{Binding IsTokenVisible}" Width="18" Height="18" />
                    </Panel>
                  </Button>
                  <Button Grid.Column="2" Classes="icon-button"
                          Command="{Binding GitHubVerifyCommand}"
                          IsEnabled="{Binding GitHubTokenInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          ToolTip.Tip="{local:Localize VerifyToken}">
                    <mi:MaterialIcon Kind="ShieldCheck" Width="18" Height="18" />
                  </Button>
                  <Button Grid.Column="3" Classes="action-button primary"
                          Command="{Binding GitHubConnectCommand}"
                          Content="{local:Localize Save}"
                          IsEnabled="{Binding GitHubTokenInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Button Grid.Column="4" Classes="action-button"
                          Command="{Binding GitHubCancelUpdateCommand}"
                          Content="{local:Localize Cancel}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Logging -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize Logging}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{local:Localize LogLevel}"
                         Classes="field-label"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        SelectedIndex="{Binding LogLevelIndex}"
                        Classes="settings-dropdown"
                        AutomationProperties.Name="LogLevel">
                <ComboBoxItem Content="Debug" />
                <ComboBoxItem Content="Information" />
                <ComboBoxItem Content="Warning" />
                <ComboBoxItem Content="Error" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Config Location -->
        <Border Classes="settings-card">
          <StackPanel Spacing="0">
            <TextBlock Text="{local:Localize StorageLocation}"
                       Classes="section-title"
                       Margin="{StaticResource ThicknessBottomM}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding ConfigLocation}"
                         Classes="readonly-value"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Storage Location" />
              <Button Grid.Column="1"
                      Command="{Binding OpenConfigFolderCommand}"
                      Classes="icon-button"
                      ToolTip.Tip="{local:Localize OpenInFileManager}"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource SpacingM}"
                    Margin="{StaticResource ThicknessTopS}">
          <Button Command="{Binding ResetCommand}"
                  Content="{local:Localize ResetToDefaults}"
                  Classes="action-button"
                  IsEnabled="{Binding !IsSaving}"
                  AutomationProperties.Name="Reset to Defaults" />

          <Button Command="{Binding SaveCommand}"
                  Classes="action-button primary"
                  IsEnabled="{Binding !IsSaving}"
                  AutomationProperties.Name="Save Settings">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{local:Localize SaveSettings}" />
              <ProgressBar IsIndeterminate="True"
                           Width="16"
                           Height="16"
                           IsVisible="{Binding IsSaving}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>


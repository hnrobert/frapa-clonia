<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrapaClonia.UI.ViewModels;assembly=FrapaClonia.UI"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="FrapaClonia.UI.Views.LogsView"
             x:DataType="vm:LogsViewModel">

  <Design.DataContext>
    <vm:LogsViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Page Header -->
    <Border Grid.Row="0" Classes="page-header">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpacingM}">
          <StackPanel Spacing="{StaticResource SpacingS}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
              <TextBlock Text="{local:Localize Logs}"
                         Classes="page-title" />
              <Button Command="{Binding OpenSettingsCommand}"
                      ToolTip.Tip="{local:Localize LogSettings}"
                      Classes="icon-button"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Cog" Width="18" Height="18" />
              </Button>
              <Button Command="{Binding RefreshCommand}"
                      ToolTip.Tip="{local:Localize Refresh}"
                      Classes="icon-button"
                      IsEnabled="{Binding !IsClearing}"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" />
              </Button>
              <Button Command="{Binding ClearLogsCommand}"
                      ToolTip.Tip="{local:Localize ClearAll}"
                      Classes="icon-button"
                      IsEnabled="{Binding !IsClearing}"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="DeleteVariant" Width="18" Height="18" />
              </Button>
              <Button Command="{Binding ExportLogsCommand}"
                      ToolTip.Tip="{local:Localize Export}"
                      Classes="icon-button"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Export" Width="18" Height="18" />
              </Button>
            </StackPanel>
            <TextBlock Text="{local:Localize ViewRealtimeLogsFromFrpc}"
                       Classes="page-subtitle" />
          </StackPanel>
        </StackPanel>

        <!-- Status Info -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingM}"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="{StaticResource FontSizeM}"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Page Toolbar -->
    <Border Grid.Row="1" Classes="page-toolbar">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingM}">
        <TextBlock Classes="field-label">
          <Run Text="{local:Localize LogLevelLabel}" /><Run Text=":" />
        </TextBlock>
        <ComboBox ItemsSource="{Binding LogLevels}"
                  SelectedItem="{Binding SelectedLogLevel}"
                  PlaceholderText="{local:Localize AllLevels}"
                  Classes="filter-box" />

        <Border Width="1"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Margin="{StaticResource ThicknessXS}"
                VerticalAlignment="Stretch" />

        <!-- Search Box -->
        <TextBox Text="{Binding SearchQuery}"
                 Watermark="Search logs..."
                 Classes="search-box"
                 MinWidth="200" />
        <TextBlock Text="{Binding SearchMatchCount, StringFormat='{}{0} matches'}"
                   Classes="hint"
                   VerticalAlignment="Center"
                   IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Width="1"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Margin="{StaticResource ThicknessXS}"
                VerticalAlignment="Stretch" />

        <CheckBox IsChecked="{Binding IsFollowEnabled}"
                  Content="{local:Localize AutoScroll}"
                  VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Page Content — stretches to fill remaining space -->
    <Border Grid.Row="2" Classes="page-content">
      <Grid>
        <!-- Empty State -->
        <Border IsVisible="{Binding LogText, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                Classes="empty-state"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="{StaticResource SpacingM}" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="FileDocumentOutline"
                             Width="48"
                             Height="48"
                             Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             HorizontalAlignment="Center" />
            <TextBlock Text="{local:Localize NoLogsAvailable}"
                       FontSize="{StaticResource FontSizeXL}"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{local:Localize LogsWillAppearHere}"
                       FontSize="{StaticResource FontSizeM}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Log TextBox — always fills the entire area -->
        <TextBox x:Name="LogTextBox"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Classes="logViewer"
                 Padding="8,4">
          <TextBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopyClicked" />
              <MenuItem Header="Select All" InputGesture="Ctrl+A" Click="OnSelectAllClicked" />
              <Separator />
              <MenuItem Header="Clear" Click="OnClearClicked" />
            </ContextMenu>
          </TextBox.ContextMenu>
        </TextBox>
      </Grid>
    </Border>

    <!-- Settings Dialog Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding IsSettingsOpen}"
            Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Classes="card"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="{StaticResource ContentPaddingCompact}">
        <StackPanel Spacing="{StaticResource SpacingL}">
          <TextBlock Text="{local:Localize LogSettings}"
                     Classes="card-title"
                     FontSize="18" />

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{local:Localize LogLevelLabel}"
                       Classes="field-label"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      SelectedIndex="{Binding LogLevelIndex}">
              <ComboBoxItem>Trace</ComboBoxItem>
              <ComboBoxItem>Debug</ComboBoxItem>
              <ComboBoxItem>Info</ComboBoxItem>
              <ComboBoxItem>Warn</ComboBoxItem>
              <ComboBoxItem>Error</ComboBoxItem>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
            <TextBlock Grid.Column="0"
                       Text="{local:Localize MaxDays}"
                       Classes="field-label"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding LogMaxDaysText}"
                     Watermark="3" />
          </Grid>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{local:Localize LogTo}"
                       Classes="field-label"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding LogTo}"
                     Watermark="{local:Localize EgConsolePathToLogfile}" />
          </Grid>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="{StaticResource SpacingM}"
                      Margin="{StaticResource ThicknessTopS}">
            <Button Command="{Binding CancelSettingsCommand}"
                    Classes="action-button"
                    Content="{local:Localize Cancel}" />
            <Button Command="{Binding SaveSettingsCommand}"
                    Classes="action-button primary"
                    Content="{local:Localize Save}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>

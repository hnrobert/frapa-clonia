<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrapaClonia.UI.ViewModels;assembly=FrapaClonia.UI"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="FrapaClonia.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <Design.DataContext>
    <vm:DashboardViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel Margin="{StaticResource ContentPadding}">
      <StackPanel Spacing="{StaticResource SpacingL}">

        <!-- Page Header -->
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0"
                     Text="{local:Localize Dashboard}"
                     Classes="page-title" />

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="{StaticResource SpacingS}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Border Width="8" Height="8"
                    CornerRadius="{StaticResource CornerRadiusFull}"
                    Classes.status-running="{Binding IsFrpcRunning}"
                    Classes.status-stopped="{Binding !IsFrpcRunning}">
              <Border.Styles>
                <Style Selector="Border.status-running">
                  <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}" />
                </Style>
                <Style Selector="Border.status-running">
                  <Style.Animations>
                    <Animation Duration="0:0:1.5" IterationCount="Infinite">
                      <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                      </KeyFrame>
                      <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.4" />
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
                <Style Selector="Border.status-stopped">
                  <Setter Property="Background" Value="{DynamicResource SystemErrorTextColor}" />
                </Style>
              </Border.Styles>
            </Border>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{StaticResource FontSizeM}"
                       FontWeight="{StaticResource FontWeightMedium}"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          </StackPanel>
        </Grid>

        <!-- Preset Management Section -->
        <Border Classes="card">
          <StackPanel Spacing="{StaticResource SpacingM}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
              <mi:MaterialIcon Kind="FolderSettings" Width="18" Height="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Text="{local:Localize PresetManagement}"
                         Classes="card-title" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
              <!-- Preset Name (Editable only when renaming) -->
              <TextBox Grid.Column="0"
                       Text="{Binding PresetName}"
                       Watermark="{local:Localize PresetName}"
                       FontSize="14"
                       IsReadOnly="{Binding !IsRenaming}"
                       KeyDown="OnPresetNameKeyDown"
                       x:Name="PresetNameTextBox" />

              <!-- Action Buttons -->
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="{StaticResource SpacingS}">
                <!-- Rename/Save Button -->
                <Button Command="{Binding RenamePresetCommand}"
                        ToolTip.Tip="{local:Localize RenamePreset}"
                        Classes="icon-button">
                  <Panel>
                    <mi:MaterialIcon Kind="Pencil" Width="18" Height="18"
                                     IsVisible="{Binding !IsRenaming}" />
                    <mi:MaterialIcon Kind="Check" Width="18" Height="18"
                                     IsVisible="{Binding IsRenaming}" />
                  </Panel>
                </Button>
                <!-- Cancel Button (only visible when renaming) -->
                <Button Command="{Binding CancelRenameCommand}"
                        ToolTip.Tip="{local:Localize CancelRename}"
                        Classes="icon-button"
                        IsVisible="{Binding IsRenaming}">
                  <mi:MaterialIcon Kind="Close" Width="18" Height="18" />
                </Button>
                <Button Command="{Binding DuplicatePresetCommand}"
                        ToolTip.Tip="{local:Localize DuplicatePreset}"
                        Classes="icon-button"
                        IsEnabled="{Binding !IsRenaming}">
                  <mi:MaterialIcon Kind="ContentCopy" Width="18" Height="18" />
                </Button>
                <Button Command="{Binding DeletePresetCommand}"
                        ToolTip.Tip="{local:Localize DeletePreset}"
                        Classes="icon-button"
                        IsEnabled="{Binding !IsRenaming}">
                  <mi:MaterialIcon Kind="Delete" Width="18" Height="18" />
                </Button>

                <Border Width="1"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        Margin="{StaticResource ThicknessXS}" />

                <!-- Import Button -->
                <Button Command="{Binding ImportCommand}"
                        ToolTip.Tip="{local:Localize ImportPreset}"
                        Classes="icon-button">
                  <mi:MaterialIcon Kind="Import" Width="18" Height="18" />
                </Button>

                <!-- Export Menu -->
                <Menu ToolTip.Tip="{local:Localize ExportPreset}"
                      Classes="icon-menu">
                  <MenuItem Header="">
                    <MenuItem.HeaderTemplate>
                      <DataTemplate>
                        <mi:MaterialIcon Kind="Export" Width="18" Height="18" />
                      </DataTemplate>
                    </MenuItem.HeaderTemplate>
                    <MenuItem Header="TOML" Command="{Binding ExportTomlCommand}" />
                    <MenuItem Header="INI" Command="{Binding ExportIniCommand}" />
                  </MenuItem>
                </Menu>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Primary Action Bar -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Action Buttons -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingM}"
                        VerticalAlignment="Center">
              <!-- Install Service (shown when native mode and service not installed) -->
              <Button Command="{Binding InstallServiceCommand}"
                      Classes="primary icon-text-button"
                      IsVisible="{Binding NeedsServiceInstall}">
                <StackPanel>
                  <mi:MaterialIcon Kind="Download" />
                  <TextBlock Text="{local:Localize InstallService}" />
                </StackPanel>
              </Button>

              <!-- Start (shown when service is installed or not native mode) -->
              <Button Command="{Binding StartFrpcCommand}"
                      Classes="primary icon-text-button"
                      IsVisible="{Binding !NeedsServiceInstall}">
                <StackPanel>
                  <mi:MaterialIcon Kind="Play" />
                  <TextBlock Text="{local:Localize StartFrpc}" />
                </StackPanel>
              </Button>

              <Button Command="{Binding StopFrpcCommand}"
                      Classes="action-button icon-text-button">
                <StackPanel>
                  <mi:MaterialIcon Kind="Stop" />
                  <TextBlock Text="{local:Localize StopFrpc}" />
                </StackPanel>
              </Button>

              <Button Command="{Binding RestartFrpcCommand}"
                      Classes="action-button icon-text-button">
                <StackPanel>
                  <mi:MaterialIcon Kind="Refresh" />
                  <TextBlock Text="{local:Localize RestartFrpc}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Status Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                    CornerRadius="{StaticResource CornerRadiusS}"
                    Padding="{StaticResource ThicknessS}"
                    HorizontalAlignment="Right">
              <Grid ColumnDefinitions="Auto,10,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Classes="label">
                  <Run Text="{local:Localize ProcessId}" /><Run Text=":" />
                </TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding FrpcProcessId, TargetNullValue='N/A'}"
                           Classes="value"
                           Margin="{StaticResource ThicknessLeftS}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Classes="label"
                           Margin="{StaticResource ThicknessTopS}">
                  <Run Text="{local:Localize ServerName}" /><Run Text=":" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding ServerAddress}"
                           Classes="value"
                           Margin="{StaticResource ThicknessLeftTopS}" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Section Header -->
        <TextBlock Text="{local:Localize QuickAccess}"
                   Classes="section-title"
                   Margin="{StaticResource ThicknessTopS}" />

        <!-- Quick Access Cards -->
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="{StaticResource CardGridSpacing}">

          <!-- Proxy Management Card -->
          <Border Grid.Column="0" Classes="card">
            <Grid RowDefinitions="Auto,*,Auto" Height="120">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                <mi:MaterialIcon Kind="Proxy" Width="18" Height="18" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{local:Localize ProxyManagement}"
                           Classes="card-title" />
              </StackPanel>
              <TextBlock Grid.Row="1"
                         Classes="card-description"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Text="{local:Localize ManageConfiguration}" />
              <Button Grid.Row="2"
                      Content="{local:Localize Manage}"
                      Command="{Binding NavigateToProxyListCommand}"
                      HorizontalAlignment="Left"
                      Classes="action-button" />
            </Grid>
          </Border>

          <!-- Deployment Card -->
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,*,Auto" Height="120">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                <mi:MaterialIcon Kind="CloudDownload" Width="18" Height="18" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{local:Localize Deployment}"
                           Classes="card-title" />
              </StackPanel>
              <TextBlock Grid.Row="1"
                         Classes="card-description"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Text="{local:Localize SetupFrpcStatus}" />
              <Button Grid.Row="2"
                      Content="{local:Localize Setup}"
                      Command="{Binding NavigateToDeploymentCommand}"
                      HorizontalAlignment="Left"
                      Classes="action-button" />
            </Grid>
          </Border>

          <!-- Logs Card -->
          <Border Grid.Column="2" Classes="card">
            <Grid RowDefinitions="Auto,*,Auto" Height="120">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                <mi:MaterialIcon Kind="FileDocument" Width="18" Height="18" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{local:Localize Logs}"
                           Classes="card-title" />
              </StackPanel>
              <TextBlock Grid.Row="1"
                         Classes="card-description"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Text="{local:Localize ViewFrpcStatus}" />
              <Button Grid.Row="2"
                      Content="{local:Localize View}"
                      Command="{Binding NavigateToLogsCommand}"
                      HorizontalAlignment="Left"
                      Classes="action-button" />
            </Grid>
          </Border>
        </Grid>

        <!-- Section Header -->
        <TextBlock Text="{local:Localize Overview}"
                   Classes="section-title"
                   Margin="{StaticResource ThicknessTopS}" />

        <!-- Overview Stats -->
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="{StaticResource CardGridSpacing}">
          <!-- Running Instances -->
          <Border Grid.Column="0" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ThicknessLeftM}">
                <TextBlock Text="{Binding RunningInstanceCount, StringFormat={}{0}}"
                           FontSize="24"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="{local:Localize RunningInstances}"
                           FontSize="{StaticResource FontSizeM}"
                           FontWeight="{StaticResource FontWeightMedium}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="{StaticResource ThicknessTopXS}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Current Preset Runtime -->
          <Border Grid.Column="1" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ThicknessLeftM}">
                <TextBlock Text="{Binding CurrentPresetRuntime}"
                           FontSize="{StaticResource FontSizeL}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="{local:Localize CurrentPresetRuntime}"
                           FontSize="{StaticResource FontSizeM}"
                           FontWeight="{StaticResource FontWeightMedium}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="{StaticResource ThicknessTopXS}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Total Active Proxies -->
          <Border Grid.Column="2" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ThicknessLeftM}">
                <TextBlock Text="{Binding TotalActiveProxies, StringFormat={}{0}}"
                           FontSize="24"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="{local:Localize TotalActiveProxies}"
                           FontSize="{StaticResource FontSizeM}"
                           FontWeight="{StaticResource FontWeightMedium}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="{StaticResource ThicknessTopXS}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
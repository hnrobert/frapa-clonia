<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrapaClonia.UI.ViewModels;assembly=FrapaClonia.UI"
        xmlns:converters="clr-namespace:FrapaClonia.UI.Converters;assembly=FrapaClonia.UI"
        xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="800"
        x:Class="FrapaClonia.UI.Views.ProxyEditorView"
        x:DataType="vm:ProxyEditorViewModel"
        Title="Edit Proxy"
        Width="780"
        Height="800"
        MinWidth="600"
        MinHeight="600">

  <Design.DataContext>
    <vm:ProxyEditorViewModel />
  </Design.DataContext>

  <Window.Resources>
    <converters:EmptyStringConverter x:Key="EmptyStringConverter" />
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel Margin="{StaticResource ContentPadding}">
      <Grid RowDefinitions="Auto,Auto">
        <!-- Header Section -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource SpacingS}" Margin="{StaticResource ThicknessBottomL}">
          <TextBlock Text="{local:Localize ProxyConfiguration}"
                     Classes="page-title" />
          <TextBlock Text="{local:Localize ConfigureYourProxySettingsBelow}"
                     Classes="page-subtitle" />
        </StackPanel>

        <!-- Form Content -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource SpacingL}">

          <!-- Basic Settings Section -->
          <Border Classes="card">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize BasicSettings}" Classes="section-title" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="field-label">
                    <Run Text="{local:Localize ProxyName}" />
                    <Run Text="*" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                  </TextBlock>
                  <TextBox Text="{Binding ProxyName}"
                           Watermark="e.g., my-web-server"
                           Name="ProxyNameTextBox" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Classes="field-label">
                    <Run Text="{local:Localize ProxyType}" />
                    <Run Text="*" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                  </TextBlock>
                  <ComboBox ItemsSource="{Binding ProxyTypes}"
                            SelectedItem="{Binding ProxyType}"
                            Name="ProxyTypeComboBox" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Local Settings Section -->
          <Border Classes="card">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize LocalSettings}" Classes="section-title" />

              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{local:Localize LocalIP}" Classes="field-label" />
                  <TextBox Text="{Binding LocalIP}"
                           Watermark="127.0.0.1"
                           Name="LocalIPTextBox" />
                  <TextBlock Text="{local:Localize TheIPOfTheLocalService}"
                             Classes="hint" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBlock Classes="field-label">
                    <Run Text="{local:Localize LocalPort}" />
                    <Run Text="*" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                  </TextBlock>
                  <NumericUpDown Value="{Binding LocalPort}"
                                 Minimum="1"
                                 Maximum="65535"
                                 Increment="1"
                                 FormatString="0"
                                 Width="NaN"
                                 HorizontalAlignment="Stretch"
                                 Name="LocalPortNumeric" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0"
                            IsVisible="{Binding IsTcpOrUdp}">
                  <TextBlock Classes="field-label">
                    <Run Text="{local:Localize RemotePort}" />
                    <Run Text="*" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                  </TextBlock>
                  <NumericUpDown Value="{Binding RemotePort}"
                                 Minimum="1"
                                 Maximum="65535"
                                 Increment="1"
                                 FormatString="0"
                                 Width="NaN"
                                 HorizontalAlignment="Stretch"
                                 Name="RemotePortNumeric" />
                  <TextBlock Text="The port on the frp server"
                             Classes="hint" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Domain Settings Section (Conditional) -->
          <Border Classes="card" IsVisible="{Binding NeedsDomain}">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize DomainSettings}" Classes="section-title" />

              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                  <TextBlock Text="{local:Localize CustomDomains}" Classes="field-label" />
                  <TextBox Text="{Binding CustomDomains}"
                           Watermark="{local:Localize EgWwwExampleCom}"
                           Name="CustomDomainsTextBox" />
                  <TextBlock Text="{local:Localize CommaSeparatedList}"
                             Classes="hint" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="{local:Localize Subdomain}" Classes="field-label" />
                  <TextBox Text="{Binding Subdomain}"
                           Watermark="e.g., myapp (for myapp.yourdomain.com)"
                           Name="SubdomainTextBox" />
                  <TextBlock Text="{local:Localize LeaveEmptyIfUsingCustomDomains}"
                             Classes="hint" />
                </StackPanel>

                <!-- HTTP Authentication (Conditional) -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            IsVisible="{Binding IsHttpOrHttps}"
                            Margin="{StaticResource ThicknessTopM}">
                  <TextBlock Text="{local:Localize HTTPAuthentication}"
                             Classes="section-title" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}"
                        Margin="{StaticResource ThicknessTopS}">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{local:Localize Username}" Classes="field-label" />
                      <TextBox Text="{Binding HttpUser}"
                               Watermark="Optional"
                               Name="HttpUserTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{local:Localize Password}" Classes="field-label" />
                      <TextBox Text="{Binding HttpPassword}"
                               PasswordChar="*"
                               Watermark="Optional"
                               Name="HttpPasswordTextBox" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Secure Tunnel Settings Section (Conditional) -->
          <Border Classes="card" IsVisible="{Binding IsStcpOrXtcpOrSudp}">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize SecureTunnelSettings}" Classes="section-title" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="field-label">
                    <Run Text="{local:Localize SecretKey}" />
                    <Run Text="*" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                  </TextBlock>
                  <TextBox Text="{Binding SecretKey}"
                           PasswordChar="*"
                           Watermark="Shared secret for this tunnel"
                           Name="SecretKeyTextBox" />
                  <TextBlock Text="{local:Localize MustMatchTheVisitorsSecretKey}"
                             Classes="hint" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{local:Localize AllowedUsers}" Classes="field-label" />
                  <TextBox Text="{Binding AllowUsers}"
                           Watermark="Comma-separated list of allowed users"
                           Name="AllowUsersTextBox" />
                  <TextBlock Text="{local:Localize LeaveEmptyToAllowAllUsers}"
                             Classes="hint" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- TCP Multiplexer Settings Section (Conditional) -->
          <Border Classes="card" IsVisible="{Binding IsTcpmux}">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize TcpMultiplexerSettings}" Classes="section-title" />

              <StackPanel>
                <TextBlock Text="{local:Localize MultiplexerName}" Classes="field-label" />
                <TextBox Text="{Binding Multiplexer}"
                         Watermark="{local:Localize NameOfTheMultiplexer}"
                         Name="MultiplexerTextBox" />
                <TextBlock Text="{local:Localize TheMultiplexerMustBeConfiguredOnTheServer}"
                           Classes="hint" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Transport Options Section -->
          <Border Classes="card">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize TransportOptions}" Classes="section-title" />

              <CheckBox IsChecked="{Binding UseEncryption}">
                <StackPanel Spacing="{StaticResource SpacingXS}">
                  <TextBlock Text="{local:Localize EnableEncryption}" FontWeight="{StaticResource FontWeightMedium}" />
                  <TextBlock Text="{local:Localize EncryptTheConnectionBetweenClientAndServer}"
                             FontSize="{StaticResource FontSizeS}"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
              </CheckBox>

              <CheckBox IsChecked="{Binding UseCompression}">
                <StackPanel Spacing="{StaticResource SpacingXS}">
                  <TextBlock Text="{local:Localize EnableCompression}" FontWeight="{StaticResource FontWeightMedium}" />
                  <TextBlock Text="{local:Localize CompressDataToReduceBandwidthUsage}"
                             FontSize="{StaticResource FontSizeS}"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
              </CheckBox>

              <StackPanel IsVisible="{Binding BandwidthLimit}" Spacing="{StaticResource SpacingS}"
                          Margin="{StaticResource ThicknessTopS}">
                <TextBlock Text="{local:Localize BandwidthLimit}" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
                  <TextBox Grid.Column="0"
                           Text="{Binding BandwidthLimit}"
                           Watermark="{local:Localize Eg1Mb256Kb}"
                           Name="BandwidthLimitTextBox" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding BandwidthLimitModes}"
                            SelectedItem="{Binding BandwidthLimitMode, Mode=TwoWay}"
                            MinWidth="100"
                            Name="BandwidthLimitModeComboBox" />
                </Grid>
                <TextBlock Text="{local:Localize LimitBandwidthForThisProxy}"
                           Classes="hint" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Health Check Section -->
          <Border Classes="card">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <CheckBox IsChecked="{Binding HealthCheckEnabled}">
                <StackPanel Spacing="{StaticResource SpacingXS}">
                  <TextBlock Text="{local:Localize EnableHealthCheck}" FontWeight="{StaticResource FontWeightSemiBold}" />
                  <TextBlock Text="{local:Localize MonitorTheHealthOfTheLocalService}"
                             FontSize="{StaticResource FontSizeS}"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
              </CheckBox>

              <StackPanel IsVisible="{Binding HealthCheckEnabled}" Spacing="{StaticResource SpacingM}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{local:Localize TypeLabel}" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding HealthCheckTypes}"
                              SelectedItem="{Binding HealthCheckType}"
                              Name="HealthCheckTypeComboBox" />
                  </StackPanel>

                  <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="{local:Localize TimeoutSeconds}" Classes="field-label" />
                    <NumericUpDown Value="{Binding HealthCheckTimeoutSeconds}"
                                   Minimum="1"
                                   Maximum="300"
                                   Increment="1"
                                   FormatString="0"
                                   Width="NaN"
                                   HorizontalAlignment="Stretch"
                                   Name="HealthCheckTimeoutNumeric" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="{local:Localize MaxFailed}" Classes="field-label" />
                    <NumericUpDown Value="{Binding HealthCheckMaxFailed}"
                                   Minimum="1"
                                   Maximum="100"
                                   Increment="1"
                                   FormatString="0"
                                   Width="NaN"
                                   HorizontalAlignment="Stretch"
                                   Name="HealthCheckMaxFailedNumeric" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="{local:Localize IntervalSeconds}" Classes="field-label" />
                    <NumericUpDown Value="{Binding HealthCheckIntervalSeconds}"
                                   Minimum="1"
                                   Maximum="3600"
                                   Increment="1"
                                   FormatString="0"
                                   Width="NaN"
                                   HorizontalAlignment="Stretch"
                                   Name="HealthCheckIntervalNumeric" />
                  </StackPanel>
                </Grid>

                <StackPanel IsVisible="{Binding IsHttpOrHttps}" Spacing="{StaticResource SpacingM}">
                  <StackPanel>
                    <TextBlock Text="{local:Localize PathLabel}" Classes="field-label" />
                    <TextBox Text="{Binding HealthCheckPath}"
                             Watermark="/health"
                             Name="HealthCheckPathTextBox" />
                  </StackPanel>

                  <StackPanel>
                    <TextBlock Text="{local:Localize HeadersLabel}" Classes="field-label" />
                    <TextBox Text="{Binding HealthCheckHeaders}"
                             Watermark="{local:Localize HeaderNameValue}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             Name="HealthCheckHeadersTextBox" />
                    <TextBlock Text="{local:Localize OneHeaderPerLine}"
                               Classes="hint" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Plugin Configuration Section -->
          <Border Classes="card">
            <StackPanel Spacing="{StaticResource SpacingM}">
              <TextBlock Text="{local:Localize PluginConfiguration}" Classes="section-title" />

              <StackPanel Spacing="{StaticResource SpacingS}">
                <TextBlock Text="{local:Localize PluginTypeLabel}" Classes="field-label" />
                <ComboBox ItemsSource="{Binding PluginTypes}"
                          SelectedItem="{Binding PluginType}"
                          Name="PluginTypeComboBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource EmptyStringConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- HTTP Proxy Plugin -->
              <StackPanel IsVisible="{Binding IsHttpProxyPlugin}"
                          Spacing="{StaticResource SpacingS}">
                <TextBlock Text="{local:Localize HTTPProxyUrl}" Classes="field-label" />
                <TextBox Text="{Binding PluginHttpProxyUrl}"
                         Watermark="http://proxy.example.com:8080"
                         Name="PluginHttpProxyUrlTextBox" />
              </StackPanel>

              <!-- SOCKS5 Plugin -->
              <StackPanel IsVisible="{Binding IsSocks5Plugin}"
                          Spacing="{StaticResource SpacingS}">
                <TextBlock Text="{local:Localize Socks5Url}" Classes="field-label" />
                <TextBox Text="{Binding PluginSocks5Url}"
                         Watermark="socks5://proxy.example.com:1080"
                         Name="PluginSocks5UrlTextBox" />
              </StackPanel>

              <!-- Static File Plugin -->
              <StackPanel IsVisible="{Binding IsStaticFilePlugin}"
                          Spacing="{StaticResource SpacingM}">
                <TextBlock Text="{local:Localize StaticFilePluginSettings}" Classes="section-title" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{local:Localize LocalPath}" Classes="field-label" />
                    <TextBox Text="{Binding PluginStaticFilePath}"
                             Watermark="/path/to/files"
                             Name="PluginStaticFilePathTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{local:Localize UrlPrefix}" Classes="field-label" />
                    <TextBox Text="{Binding PluginStaticFilePrefixUrl}"
                             Watermark="/files"
                             Name="PluginStaticFilePrefixUrlTextBox" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- HTTPS to HTTP Plugin -->
              <StackPanel IsVisible="{Binding IsHttps2HTTPPlugin}"
                          Spacing="{StaticResource SpacingM}">
                <TextBlock Text="{local:Localize HttpsToHTTPPluginSettings}" Classes="section-title" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="{local:Localize LocalAddress}" Classes="field-label" />
                    <TextBox Text="{Binding PluginHttps2HttpLocalAddr}"
                             Watermark="127.0.0.1:80"
                             Name="PluginHttps2HttpLocalAddrTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="{local:Localize CrtPath}" Classes="field-label" />
                    <TextBox Text="{Binding PluginHttps2HttpCrtPath}"
                             Name="PluginHttps2HttpCrtPathTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="{local:Localize Keypath}" Classes="field-label" />
                    <TextBox Text="{Binding PluginHttps2HttpKeyPath}"
                             Name="PluginHttps2HttpKeyPathTextBox" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- HTTP to HTTPS Plugin -->
              <StackPanel IsVisible="{Binding IsHttp2HttpsPlugin}"
                          Spacing="{StaticResource SpacingM}">
                <TextBlock Text="{local:Localize HTTPToHttpsPluginSettings}" Classes="section-title" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingM}">
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="{local:Localize LocalAddress}" Classes="field-label" />
                    <TextBox Text="{Binding PluginHttp2HttpsLocalAddr}"
                             Watermark="127.0.0.1:443"
                             Name="PluginHttp2HttpsLocalAddrTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="{local:Localize CrtPath}" Classes="field-label" />
                    <TextBox Text="{Binding PluginHttp2HttpsCrtPath}"
                             Name="PluginHttp2HttpsCrtPathTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="{local:Localize Keypath}" Classes="field-label" />
                    <TextBox Text="{Binding PluginHttp2HttpsKeyPath}"
                             Name="PluginHttp2HttpsKeyPathTextBox" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Validation Error Banner -->
          <Border Background="{DynamicResource SystemControlErrorTextForegroundBrush}"
                  CornerRadius="{StaticResource CornerRadiusM}"
                  Padding="{StaticResource ThicknessM}"
                  IsVisible="{Binding HasValidationError}">
            <StackPanel Spacing="{StaticResource SpacingS}">
              <TextBlock Text="{local:Localize ConfigurationError}"
                         FontWeight="{StaticResource FontWeightSemiBold}"
                         Foreground="White" />
              <TextBlock Text="{Binding ValidationError}"
                         Foreground="White"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Action Buttons -->
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="{StaticResource SpacingM}"
                      Margin="{StaticResource ThicknessTopS}">
            <Button Command="{Binding CancelCommand}"
                    Classes="action-button"
                    IsEnabled="{Binding !IsSaving}"
                    Content="{local:Localize Cancel}"
                    Name="CancelButton" />

            <Button Command="{Binding SaveCommand}"
                    Classes="action-button primary icon-text-button"
                    IsEnabled="{Binding !IsSaving}"
                    Name="SaveButton">
              <StackPanel>
                <TextBlock Text="{local:Localize Save}" />
                <ProgressBar IsIndeterminate="True"
                             Width="16" Height="16"
                             IsVisible="{Binding IsSaving}"
                             Margin="0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Panel>
  </ScrollViewer>
</Window>


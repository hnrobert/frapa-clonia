<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrapaClonia.UI.MarkupExtensions;assembly=FrapaClonia.UI"
        x:Class="FrapaClonia.UI.Views.SwitchModeConfirmDialog"
        Title="{local:Localize SwitchMode_Title}"
        Width="420" Height="220"
        MinWidth="380" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="False"
        ShowInTaskbar="False">

  <Window.Styles>
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/SharedStyles.axaml" />
    <StyleInclude Source="avares://FrapaClonia.UI/Styles/ButtonStyles.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="*,Auto" Margin="24">

    <StackPanel Grid.Row="0" Spacing="8" VerticalAlignment="Center">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
      <TextBlock x:Name="SubMessageText" TextWrapping="Wrap" FontSize="12"
                 Opacity="0.7" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Classes="secondary"
              Content="{local:Localize Cancel}" />
      <Button x:Name="ContinueButton" Classes="secondary"
              Content="{local:Localize SwitchMode_Continue}" />
      <Button x:Name="StopAndContinueButton" Classes="danger"
              Content="{local:Localize SwitchMode_StopAndContinue}" />
    </StackPanel>

  </Grid>
</Window>

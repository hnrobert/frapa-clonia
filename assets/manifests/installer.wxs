<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="FrapaClonia"
    Manufacturer="hnrobert"
    Version="$(var.Version)"
    UpgradeCode="1ece8a4b-7c8c-4ea4-ae70-1a129d9ef5f8"
    Scope="perMachine">

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="src/FrapaClonia/Assets/favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Directories -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FrapaClonia" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="FrapaClonia" />
    </StandardDirectory>

    <!-- Shortcuts -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppShortcuts" Guid="b2c3d4e5-f6a7-8901-bcde-f12345678901">
        <Shortcut
          Id="DesktopShortcut"
          Name="FrapaClonia"
          Description="FrapaClonia - frpc Manager"
          Target="[INSTALLFOLDER]FrapaClonia.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon"
          Directory="DesktopFolder" />

        <Shortcut
          Id="StartMenuShortcut"
          Name="FrapaClonia"
          Description="FrapaClonia - frpc Manager"
          Target="[INSTALLFOLDER]FrapaClonia.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon"
          Directory="ApplicationProgramsFolder" />

        <RemoveFolder Id="CleanUpStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FrapaClonia" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="MainFeature" Title="FrapaClonia">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="AppShortcuts" />
    </Feature>

  </Package>
</Wix>
